# ====== OneBot / NapCat 连接 ======
# NapCat 的 WebSocket 服务端地址列表（NapCat 里配置「正向 WebSocket」，默认端口 3001）
ONEBOT_WS_URLS=["ws://127.0.0.1:3001"]
# 与 NapCat 中设置的 token 保持一致（没设就留空）
ONEBOT_ACCESS_TOKEN=

# ====== 消息收集范围 ======
# "*" 表示所有群；也可以写群号列表，如 [123456, 654321]
TRACK_GROUPS=*
# 机器人启动并连接成功后，自动在这些群里开启「全体禁言」并发送提示
# （留空 [] 则不禁言；建议把要做日报的群放进来）
ON_CONNECT_GROUP_IDS=[]

# ====== 大模型（任意 OpenAI 兼容接口）======
# OpenAI / DeepSeek / 月之暗面 / 通义千问等，填 base_url + key 即可
LLM_API_KEY=sk-xxxxxxxx
# OpenAI 官方可留空；DeepSeek 示例：https://api.deepseek.com/v1
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# ====== 定时日报 ======
# 每天 22:00 自动发送当日群聊日报（时区 Asia/Shanghai）
DIGEST_CRON_HOUR=22
DIGEST_CRON_MINUTE=0
DIGEST_TIMEZONE=Asia/Shanghai
# 日报覆盖的时间范围（小时），往回看这么久
DIGEST_LOOKBACK_HOURS=24
# 日报发到哪些群；留空 [] 则发给所有正在收集的群
DIGEST_SEND_GROUPS=[]

# fastapi 提供 HTTP 服务，websockets 提供连接 NapCat 所需的 WS 客户端能力
DRIVER=~fastapi+~websockets

# 让「总结」（不带斜杠）也能触发命令；保留 "/" 支持「/总结」
COMMAND_START=["", "/"]

# ====== 其它 ======
# /总结 命令不带时间参数时的默认时间窗口（分钟）
DEFAULT_WINDOW_MINUTES=120
# 每次喂给大模型的最大消息条数（取最近的）
LLM_MAX_MESSAGES=2000
# 单条消息最长字符数（超长截断，防止刷屏消息撑爆上下文）
LLM_MAX_CHARS_PER_MESSAGE=500
# 消息数据库路径
DB_PATH=data/messages.db
